<style>
    a.link-style {
        color: var(--color-foreground);
        text-decoration: none;
        padding: 5px;
        display: inline-block;
    }

    a.link-style:hover {
        color: var(--color-secondary-text);
        transform: scale(1.1);
    }
</style>


    <a href="{{ block.settings.link_url}}" class="link-style">
        <li>
            {{ block.settings.title}}
        </li>
    </a>


{%  schema  %} 
    {
        "name": "_ms header link",
        "settings": [
            {
                "type": "richtext",
                "id": "title",
                "label": "Title",
                "default": "<p>Link Name<p>"
            },
            {
                "type": "url",
                "id": "link_url",
                "label": "URL",
            }
        ],
        "presets": [
            {
                "name": "ms-menu-link"
            }
        ]
    }
{% endschema %}