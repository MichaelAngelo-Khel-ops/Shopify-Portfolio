<style>

    #shopify-section-{{ section.id }}{
            background-color: var(--color-background);
    }

    #shopify-section-{{ section.id }} .ms-projects__title{
        text-align: center;
        margin-bottom: 50px;
    }

    #shopify-section-{{ section.id }} .margin-top {
        margin-top: {{ section.settings.margin_top }}px;
    }

    #shopify-section-{{ section.id }} .margin-bottom {
        margin-bottom: {{ section.settings.margin_bottom }}px;
    }



</style>

<div class="ms-projects-wrapper section section--page-width margin-top margin-bottom">
        <div class="ms-projects__title">
            <h1>{{ section.settings.projects_title }}</h1>
        </div>

        <div class="ms-projects__content"> 
            {% content_for 'blocks' %}
        </div>
</div>

{% render 'ms-project-js' %}

{%  schema  %} 
    {
        "name": "MS projects",
        "settings": [
            {
                "type": "header",
                "content": "section settings"
            },
            {
                "type": "text",
                "id": "projects_title",
                "label": "projects_title",
                "default": "Projects"
            },
            {
                "type": "header",
                "content": "page position"
            },
            {
                "type": "range",
                "id": "margin_top",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "margin top",
                "default": 0
            },
            {
                "type": "range",
                "id": "margin_bottom",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "margin bottom",
                "default": 0
            }
        ],
        "blocks": [
            {
                "type": "@theme"
            },
            {
                "type": "_ms-projects-popup"
            }
        ],
        "presets": [
            {
                "name": "MS Projects"
            }
        ]
    }
{% endschema %}