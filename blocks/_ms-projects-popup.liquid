
<style>
    #shopify-block-{{ block.id }} {
        border-bottom: 1px solid var(--color-border);
    }

    #shopify-block-{{ block.id }} .ms-project-item__row {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 24px 0;
        background: none;
        border: none;
        width: 100%;
        text-align: left;
        cursor: pointer;
        font: inherit;
    }

    #shopify-block-{{ block.id }} .ms-project-item__index {
        color: var(--color-secondary-text);
        font-size: 14px;
        min-width: 30px;
    }

    #shopify-block-{{ block.id }} .ms-project-item__info {
        flex: 1;
    }

    #shopify-block-{{ block.id }} .ms-project-item__title {
        margin: 0 0 4px;
    }

    #shopify-block-{{ block.id }} .ms-project-item__tags {
        margin: 0;
        font-size: 13px;
        color: var(--color-foreground);
        opacity: 0.6;
        font-family: monospace;
    }

    #shopify-block-{{ block.id }} .ms-project-item__icon {
        font-size: 20px;
        color: var(--color-foreground);
        opacity: 0.5;
        transition: transform 0.25s ease;
    }

    #shopify-block-{{ block.id }} .ms-project-item__row[aria-expanded="true"] .ms-project-item__icon {
        transform: rotate(45deg);
    }

    /* --- The accordion panel --- */
    #shopify-block-{{ block.id }} .ms-project-item__panel {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s ease;
    }

    #shopify-block-{{ block.id }} .ms-project-item__panel-inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        padding-bottom: 40px;
        align-items: start;
    }

    #shopify-block-{{ block.id }} .ms-project-item__description {
        color: var(--color-foreground);
        opacity: 0.85;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    #shopify-block-{{ block.id }} .ms-project-item__feature {
        font-size: 14px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
    }

    #shopify-block-{{ block.id }} .ms-project-item__feature-label {
        color: var(--color-primary);
        font-weight: 600;
        margin-right: 6px;
    }

    #shopify-block-{{ block.id }} .ms-project-item__buttons {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    #shopify-block-{{ block.id }} .ms-project-item__btn {
        padding: 12px 20px;
        border-radius: 6px;
        font-size: 14px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    #shopify-block-{{ block.id }} .ms-project-item__btn--primary {
        background: var(--color-primary);
        color: #fff;
    }

    #shopify-block-{{ block.id }} .ms-project-item__btn--secondary {
        border: 1px solid var(--color-border);
        color: var(--color-foreground);
    }

    #shopify-block-{{ block.id }} .ms-project-item__image-wrapper {
        border-radius: 12px;
        overflow: hidden;
        width: 100%;
    }

    #shopify-block-{{ block.id }} .ms-project-item__image {
        width: 100%;
        display: block;
        transition: transform 1s ease;
    }

    #shopify-block-{{ block.id }} .ms-project-item__icon {
        --fill-color: var(--color-secondary-text);
        fill: var(--color-secondary-text);
        width: 25px;    
        height: auto;
        margin-right: 8px;
    }

    #shopify-block-{{ block.id }} .ms-project-item__image-trigger {
    background: none;
    border: none;
    padding: 0;
    cursor: zoom-in;
    display: block;
    width: 100%;
    }

    #shopify-block-{{ block.id }} .ms-project-item__image-trigger:hover .ms-project-item__image {
        transform: scale(1.08);
    }

    .ms-lightbox {
        border: none;
        padding: 0;
        background: transparent;
        width: 100%;
        height: 100%;
        margin: auto;
    }

    .ms-lightbox::backdrop {
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(4px);
    }

    .ms-lightbox__image {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .ms-lightbox__image-container {
        max-width: 90vw;
        max-height: 90vh;
        width: auto;
        display: block;
        border-radius: 8px;
        margin: auto;
    }

    .ms-lightbox__close {
        position: fixed;
        top: 24px;
        right: 24px;
        background: rgba(0, 0, 0, 0.6);
        border: none;
        color: #fff;
        font-size: 28px;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
    }

    @media (max-width: 749px) {
        #shopify-block-{{ block.id }} .ms-project-item__panel-inner {
            grid-template-columns: 1fr;
        }
    }

</style>


<div {{ block.shopify_attributes }} class="ms-project-item">
    <button class="ms-project-item__row" data-accordion-trigger type="button" aria-expanded="false">
        <span class="ms-project-item__index">{{ block.settings.index }}</span>

        <div class="ms-project-item__info">
            <h3 class="ms-project-item__title">{{ block.settings.title }}</h3>
            {% if block.settings.tech_stack != blank %}
                <p class="ms-project-item__tags">{{ block.settings.tech_stack }}</p>
            {% endif %}
        </div>

        <span class="ms-project-item__icon">+</span>
    </button>

    <div class="ms-project-item__panel" data-accordion-panel>
        <div class="ms-project-item__panel-inner">
            <div class="ms-project-item__details">
                {% if block.settings.description != blank %}
                    <div class="ms-project-item__description">{{ block.settings.description }}</div>
                {% endif %}

                {% if block.settings.feature_1_label != blank %}
                    <div class="ms-project-item__feature">
                        {% render 'ms-project-icon-puzzle', icon_class: 'ms-project-item__icon' %}
                        <span class="ms-project-item__feature-label">{{ block.settings.feature_1_label }}:</span>
                        <span class="ms-project-item__feature-value">{{ block.settings.feature_1_value }}</span>
                    </div>
                {% endif %}
                {% if block.settings.feature_2_label != blank %}
                    <div class="ms-project-item__feature">
                        {%  render 'ms-project-icon-target', icon_class: 'ms-project-item__icon' %}
                        <span class="ms-project-item__feature-label">{{ block.settings.feature_2_label }}:</span>
                        <span class="ms-project-item__feature-value">{{ block.settings.feature_2_value }}</span>
                    </div>
                {% endif %}
                {% if block.settings.feature_3_label != blank %}
                    <div class="ms-project-item__feature">
                        {%  render 'ms-project-icon-arrow', icon_class: 'ms-project-item__icon' %}
                        <span class="ms-project-item__feature-label">{{ block.settings.feature_3_label }}:</span>
                        <span class="ms-project-item__feature-value">{{ block.settings.feature_3_value }}</span>
                    </div>
                {% endif %}

                <div class="ms-project-item__buttons">
                    {% if block.settings.link != blank %}
                        <a href="{{ block.settings.link }}" class="ms-project-item__btn ms-project-item__btn--primary" target="_blank" rel="noopener">
                            View Live
                        </a>
                    {% endif %}
                    {% if block.settings.code_link != blank %}
                        <a href="{{ block.settings.code_link }}" class="ms-project-item__btn ms-project-item__btn--secondary" target="_blank" rel="noopener">
                            Code
                        </a>
                    {% endif %}
                </div>
            </div>

            {% if block.settings.image %}
                <div class="ms-project-item__image-wrapper">
                    <button class="ms-project-item__image-trigger" data-lightbox-trigger="lightbox-{{ block.id }}" type="button">
                        {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'ms-project-item__image', loading: 'lazy' }}
                    </button>
                </div>
            
                <dialog class="ms-lightbox" id="lightbox-{{ block.id }}">
                    <button class="ms-lightbox__close" data-lightbox-close type="button" aria-label="Close">&times;</button>
                    <div class="image_description">
                        sample testing
                    </div>
                    <div class="ms-lightbox__image-container">
                        {{ block.settings.image_overlay | image_url: width: 2000 | image_tag: class: 'ms-lightbox__image'}}
                    </div>
                </dialog>
            {% endif %}

        </div>
    </div>
</div>

{% schema %}
{
    "name": "Project item",
    "settings": [
        {
            "type": "text",
            "id": "index",
            "label": "Index number",
            "default": "01"
        },
        {
            "type": "text",
            "id": "title",
            "label": "Project title",
            "default": "Project Name"
        },
        {
            "type": "text",
            "id": "tech_stack",
            "label": "Tech stack",
            "info": "Separate with · e.g. React · TailwindCSS · Vercel",
            "default": "React · TailwindCSS · JavaScript"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description"
        },
        {
            "type": "text",
            "id": "feature_1_label",
            "label": "Feature 1 label"
        },
        {
            "type": "text",
            "id": "feature_1_value",
            "label": "Feature 1 value"
        },
        {
            "type": "text",
            "id": "feature_2_label",
            "label": "Feature 2 label"
        },
        {
            "type": "text",
            "id": "feature_2_value",
            "label": "Feature 2 value"
        },
        {
            "type": "text",
            "id": "feature_3_label",
            "label": "Feature 3 label"
        },
        {
            "type": "text",
            "id": "feature_3_value",
            "label": "Feature 3 value"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Project image"
        },
        {
            "type": "image_picker",
            "id": "image_overlay",
            "label": "Project image"
        },
        {
            "type": "url",
            "id": "link",
            "label": "Live link"
        },
        {
            "type": "url",
            "id": "code_link",
            "label": "Code link"
        }
    ]
}
{% endschema %}