<style>
    #shopify-section-{{ section.id }} {
    }

    #shopify-section-{{ section.id }} .ms-header-wrapper {
        display: flex;
        padding: 20px 30px;
        margin: auto;
        position: fixed;
        z-index: 100;
        top: 0;
        left: 0;
        right: 0;
        background: rgb(var(--color-background-rgb) / 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgb(var(--color-border-rgb, 230 230 230) / 0.3);
    }
    .ms-header__nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-left: auto;
    }
    .ms-header__menu {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .ms-header__toggle  {
        margin: auto;
        margin-left: 20px;
    }

    .mode-toggler {
        border: 1px solid var(--color-primary-button-border);
        width: 44px;
        aspect-ratio: 1;
        text-align: center;
        cursor: pointer;
        background-color: transparent;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .mode-toggler path {
        fill: var(--color-primary-button-border);
    }

    .mode-toggler:hover {
        color: var(--color-primary-button-background);
        border: 2px solid var(--color-primary-button-background);
        transform: scale(1.1);
        path {
            fill: var(--color-primary-button-background);
        }
    }

    /* toggle */
    .light-mode #sun-icon { 
        display: none; 
    }
    .light-mode #moon-icon { 
        display: block; 
    }

    #sun-icon { display: block; }
    #moon-icon { display: none; }


</style>


<div class="ms-header-wrapper">
    <div class="ms-header__logo ms-header__text">
        {% if section.settings.logo_Text ==  "logo"%}
            {% content_for 'block', type: 'logo', id: 'logo' %}
        {% else %}
            {% content_for 'block', type: 'text', id: 'text' %}
        {% endif %}
    </div>
    <div class="ms-header__nav">
        <div class="ms-header__menu">
            {% content_for 'blocks' %}
        </div>
        <div class="ms-header__toggle">
            <button id="theme-toggle" class="mode-toggler" aria-label="Toggle theme">
                <!-- Sun Icon -->
                <svg id="sun-icon" viewBox="0 0 24 24" width="24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M7.28451 10.3333C7.10026 10.8546 7 11.4156 7 12C7 14.7614 9.23858 17 12 17C14.7614 17 17 14.7614 17 12C17 9.23858 14.7614 7 12 7C11.4156 7 10.8546 7.10026 10.3333 7.28451" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> <path d="M12 2V4" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> <path d="M12 20V22" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> <path d="M4 12L2 12" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> <path d="M22 12L20 12" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> <path d="M19.7778 4.22266L17.5558 6.25424" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> <path d="M4.22217 4.22266L6.44418 6.25424" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> <path d="M6.44434 17.5557L4.22211 19.7779" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> <path d="M19.7778 19.7773L17.5558 17.5551" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> </g></svg>
                <!-- Moon Icon -->
                <svg id="moon-icon" class="dark-icon" viewBox="0 0 24 24" width="24" height="24">
                  <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.38 5.38 0 0 1-4.4 4.4 5.38 5.38 0 0 1-4.4-4.4c-.44-.06-.9-.1-1.36-.1z" fill="currentColor"/>
                </svg>
              </button>
              
        </div>

    </div>

</div>

<script defer>
    const button = document.getElementById('theme-toggle');
    button.addEventListener('click', () => {
    document.body.classList.toggle('light-mode');
    });

</script>

{%  schema  %} 
    {
        "name": "ms header",
        "settings": [
            {
                "type": "select",
                "id": "logo_Text",
                "label": "logo or text",
                "options": [
                    {
                        "value": "logo",
                        "label": "logo"
                    },
                    {
                        "value": "text",
                        "label": "text"
                    }
                ],
                "default": "logo"
            }

        ],
        "blocks": [
            {
                "type": "@theme"
            },
            {
                "type": "_ms-menu-container"
            }
        ],
        
        "presets": [
            {
                "name": "MS header"
            }
        ]
    }

{% endschema %}