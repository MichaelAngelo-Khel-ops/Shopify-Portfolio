<style>
    #shopify-section-{{ section.id }} {
        
    }

    #shopify-section-{{ section.id }} .ms-header-wrapper {
        display: flex;
        padding: 20px 30px 0;
    }
    .ms-header__nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-left: auto;
    }
    .ms-header__menu {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .ms-header__toggle  {
        margin-left: 20px;
    }

    .mode-toggler {
        background-color: black;
        border: none;
        cursor: pointer;
        background-color: transparent;
    }
    .mode-toggler path {
        fill: #F1EFE7;
    }

    .dark-mode #sun-icon { display: block; }
    .dark-mode #moon-icon { display: none; }
    #sun-icon { display: none; }
    #moon-icon { display: block; }


</style>


<div class="ms-header-wrapper">
    <div class="ms-header__logo ms-header__text">
        {% if section.settings.logo_Text ==  "logo"%}
            {% content_for 'block', type: 'logo', id: 'logo' %}
        {% else %}
            {% content_for 'block', type: 'text', id: 'text' %}
        {% endif %}
    </div>
    <div class="ms-header__nav">
        <div class="ms-header__menu">
            {% content_for 'blocks' %}
        </div>
        <div class="ms-header__toggle">
            <button id="theme-toggle" class="mode-toggler" aria-label="Toggle theme">
                <!-- Sun Icon -->
                <svg id="sun-icon" class="light-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                    <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                    <g id="SVGRepo_iconCarrier"> 
                        <path d="M12 2V3" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> 
                        <path d="M12 21V22" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> 
                        <path d="M22 12L21 12" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> 
                        <path d="M3 12L2 12" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> 
                        <path d="M19.0708 4.92969L18.678 5.32252" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> 
                        <path d="M5.32178 18.6777L4.92894 19.0706" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> 
                        <path d="M19.0708 19.0703L18.678 18.6775" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> 
                        <path d="M5.32178 5.32227L4.92894 4.92943" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> 
                        <path d="M6.34141 10C6.12031 10.6256 6 11.2987 6 12C6 15.3137 8.68629 18 12 18C15.3137 18 18 15.3137 18 12C18 8.68629 15.3137 6 12 6C11.2987 6 10.6256 6.12031 10 6.34141" stroke="#F1EFE7" stroke-width="1.5" stroke-linecap="round"></path> 
                    </g>
                </svg>
                <!-- Moon Icon -->
                <svg id="moon-icon" class="dark-icon" viewBox="0 0 24 24" width="24" height="24">
                  <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.38 5.38 0 0 1-4.4 4.4 5.38 5.38 0 0 1-4.4-4.4c-.44-.06-.9-.1-1.36-.1z" fill="currentColor"/>
                </svg>
              </button>
              
        </div>
    </div>

</div>

<script defer>
    const button = document.getElementById('theme-toggle');
    button.addEventListener('click', () => {
    document.body.classList.toggle('dark-mode');
    });

</script>

{%  schema  %} 
    {
        "name": "ms header",
        "settings": [
            {
                "type": "select",
                "id": "logo_Text",
                "label": "logo or text",
                "options": [
                    {
                        "value": "logo",
                        "label": "logo"
                    },
                    {
                        "value": "text",
                        "label": "text"
                    }
                ],
                "default": "logo"
            }

        ],
        "blocks": [
            {
                "type": "@theme"
            },
            {
                "type": "_ms-menu-container"
            }
        ],
        
        "presets": [
            {
                "name": "MS header"
            }
        ]
    }

{% endschema %}