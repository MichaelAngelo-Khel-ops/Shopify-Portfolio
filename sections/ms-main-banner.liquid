
<style>
    #shopify-section-{{ section.id }} {
        min-height: 100dvh;
    }
    #shopify-section-{{ section.id }} .margin-top {
        margin-top: {{ section.settings.margin_top }}px;
    }
    #shopify-section-{{ section.id }} .margin-bottom {
        margin-bottom: {{ section.settings.margin_bottom }}px;
    }

    #shopify-section-{{ section.id }} .ms-banner-wrapper {
        position: relative;
        width: 100%;
        height: 100dvh;
        overflow: hidden;
        background-color: var(--color-background);
        background-image: 
            linear-gradient(var(--color-border) 0.5px, transparent 0.5px),
            linear-gradient(90deg, var(--color-border) 0.5px, transparent 0.5px);
        background-size: 40px 40px;
        mask-image: radial-gradient(ellipse at center, black 40%, transparent 90%);
        -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 90%);
    }

    #shopify-section-{{ section.id }} .ms-banner__background-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .ms-banner__content {
        position: absolute;
        inset: 0;
        text-align: center;
        z-index: 1;
        display: flex;
        align-items: {{ section.settings.content_position }};
        justify-content: center;
        flex-direction: column;
        gap: 10px;
        grid-column: unset;
    }

    .ms-banner__button-container {
        display: flex;
        gap: 10px;
    }

    .ms-banner__title {
        margin-bottom: 30px;
        font-size: 120px;
    }

</style>

<div class="ms-banner-wrapper section section--page-width margin-top margin-bottom">

    {% if section.settings.background_image %}
        {{ section.settings.background_image 
        |  image_url: width: 1920 
        | image_tag: class: 'ms-banner__background-image' }}
    {% endif %}

    <div class="ms-banner__background-overlay"></div>

    <div class="ms-banner__content">
        <div class="ms-banner__text">
            <h1 class="ms-banner__title">
                {{ section.settings.title }}
            </h1>
            <p class="ms-banner__subtitle">
                {{ section.settings.subtitle }}
            </p>
        </div>

        <div class="ms-banner__button-container">
            {%  if section.settings.button1_text != blank%} 
                <div class="ms-banner__button">
                    <a href="{{ section.settings.button1_link }}" class="ms-banner__button-link button-{{ section.settings.button1_style }}">
                        {{ section.settings.button1_text }}
                    </a>
                </div>
            {% endif %}
    
            {%  if section.settings.button2_text != blank%} 
                <div class="ms-banner__button">
                    <a href="{{ section.settings.button2_link }}" class="ms-banner__button-link button-{{ section.settings.button2_style }}">
                        {{ section.settings.button2_text }}
                    </a>
                </div>
            {% endif %}

        </div>
        
    </div>

</div>

{%  schema  %} 
    {
        "name": "main banner",
        "settings": [
            {
                "type": "image_picker",
                "id": "background_image",
                "label": "background image:"
            },
            {
                "type": "header",
                "content": "Content Position"
            },
            {
                "type": "select",
                "id": "content_position",
                "label": "position",
                "options": [
                    {
                        "value": "start",
                        "label": "left"
                    },
                    {
                        "value": "center",
                        "label": "center"
                    },
                    {
                        "value": "end",
                        "label": "right"
                    }
                ]
            },
            {
                "type": "richtext",
                "id": "title",
                "label": "title",
            },
            {
                "type": "richtext",
                "id": "subtitle",
                "label": "subtitle",
            },
            {
                "type": "header",
                "content": "button"
            },
            {
                "type": "text",
                "id": "button1_text",
                "label": "button text",
            },
            {
                "type": "url",
                "id": "button1_link",
                "label": "button link",
            },
            {
                "type": "select",
                "id": "button1_style",
                "label": "button style",
                "options": [
                    {
                        "value": "primary",
                        "label": "primary"
                    },
                    {
                        "value": "secondary",
                        "label": "secondary"
                    }
                ]

            },
            {
                "type": "text",
                "id": "button2_text",
                "label": "button text",
            },
            {
                "type": "url",
                "id": "button2_link",
                "label": "button link",
            },
            {
                "type": "select",
                "id": "button2_style",
                "label": "button style",
                "options": [
                    {
                        "value": "primary",
                        "label": "primary"
                    },
                    {
                        "value": "secondary",
                        "label": "secondary"
                    }
                ]

            },
            {
                "type": "header",
                "content": "page position"
            },
            {
                "type": "range",
                "id": "margin_top",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "Margin top",
                "default": 0
            },
            {
                "type": "range",
                "id": "margin_bottom",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "Margin bottom",
                "default": 0
            }
        ],
        "presets": [
            {
                "name": "ms-main-banner"
            }
        ]
    }

{% endschema %}