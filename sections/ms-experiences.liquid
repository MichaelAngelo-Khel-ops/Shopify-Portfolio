<style>

    #shopify-section-{{ section.id }}{
            background-color: var(--color-background);
    }

    #shopify-section-{{ section.id }} .ms-experience__title{
        text-align: center;
        margin-bottom: 50px;
    }

    #shopify-section-{{ section.id }} .margin-top {
        margin-top: {{ section.settings.margin_top }}px;
    }

    #shopify-section-{{ section.id }} .margin-bottom {
        margin-bottom: {{ section.settings.margin_bottom }}px;
    }



</style>

<div class="ms-experience-wrapper section section--page-width margin-top margin-bottom">
        <div class="ms-experience__title">
            <h1>{{ section.settings.experience_title }}</h1>
        </div>

        <div class="ms-experience__content"> 
            {% content_for 'blocks' %}
        </div>
</div>

{%  schema  %}  
    {
        "name": "MS experiences",
        "settings": [
            {
                "type": "header",
                "content": "section settings"
            },
            {
                "type": "text",
                "id": "experience_title",
                "label": "experience_title",
                "default": "Experiences"
            },
            {
                "type": "header",
                "content": "page position"
            },
            {
                "type": "range",
                "id": "margin_top",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "margin top",
                "default": 0
            },
            {
                "type": "range",
                "id": "margin_bottom",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "margin bottom",
                "default": 0
            }
        ], 
        "blocks": [
            {
                "type": "_ms-exp-item-container"
            }
        ],
        "presets": [
            {
                "name": "MS Experiences"
            }
        ]
    }
{% endschema %}