<style>
    #shopify-section-{{ section.id }} {
        padding: 0 30px;
        margin: 0 auto;
        background-color: var(--color-background);
    }

    #shopify-section-{{ section.id }} .margin-top {
        padding-top: {{ section.settings.margin_top }}px;
    }
    #shopify-section-{{ section.id }} .margin-bottom {
        padding-bottom: {{ section.settings.margin_bottom }}px;
    }

    #shopify-section-{{ section.id }}  .ms-tools__title {
        text-align: center;
        margin-bottom: 50px;
    }

    #shopify-section-{{ section.id }} .ms-tools__content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 50px;
    }

    #shopify-section-{{ section.id }} .ms-tools__items {
        display: grid;
        grid-template-columns: repeat(2, minmax(0px, 1fr));
        gap: 20px;
        align-items: center;
        justify-content: center;
    }

    #shopify-section-{{ section.id }} .ms-tools__content-text {
        display: flex;
        flex-direction: column;
        gap: 30px;
        padding: 40px 60px;
        border: 1px solid var(--color-input-border);
        background-color: #161A14;
    }

    #shopify-section-{{ section.id }} .ms-tools__description {
        display: flex;
        flex-direction: column;
        gap: 30px;
        font-size: 18px;
        line-height: 1.5;
    }
    #shopify-section-{{ section.id }} .ms-tools__description strong {
        color: var(--color-secondary-text);
    }

    #shopify-section-{{ section.id }} .ms-tools-slider {
        background-color: #161A14;
        padding: 20px;
        border-radius: 50px;
        overflow: hidden;

        background: rgb(var(--color-secondary-background-rgb) / 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgb(var(--color-border-rgb, 230 230 230) / 0.3);
        border-top: .5px solid rgb(var(--color-border-rgb, 230 230 230) / 0.3);

        
    }

    #shopify-section-{{ section.id }} .ms-tools-slider-track {
        gap: 20px;
        display: flex;
        width: max-content;
        animation: scroll 20s linear infinite;
    }

    #shopify-section-{{ section.id }} .ms-tools-slider:hover .ms-tools-slider-track {
        animation-play-state: paused;
    }

    /* scrolling animation */

    @keyframes scroll {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
</style>

<div class="ms-tools-wrapper section section--page-width margin-top margin-bottom">
        <div class="ms-tools__title">
            <h1>{{ section.settings.tools_title }}</h1>
        </div>

        <div class="ms-tools__content">
    
                <div class="ms-tools__items">
                    {% content_for 'blocks' %}
                </div>
    
                <div class="ms-tools__content-text">
                    <h3>{{ section.settings.text_tools_title }}</h3>
                    <div class="ms-tools__description">
                        {{ section.settings.text_tools_description }}
                    </div>
                </div>
        </div>
        <div class="ms-tools-slider">
            <div class="ms-tools-slider-track">
                {% content_for 'block', type: '_ms-icon-slider', id: "tools-icons" %}
            </div>
        </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const track = document.querySelector('.ms-tools-slider-track');
        const images = track.querySelectorAll('img');

        const initSlider = () => {
            const originalWidth = track.scrollWidth;
            track.insertAdjacentHTML('beforeend', track.innerHTML);
            track.style.setProperty('--scroll-distance', `-${originalWidth}px`);
            track.classList.add('is-ready'); // triggers animation only once sized correctly
        };

        const imagePromises = Array.from(images).map(img => {
            if (img.complete) return Promise.resolve();
            return new Promise(resolve => img.addEventListener('load', resolve));
        });

        Promise.all(imagePromises).then(initSlider);
    });
</script>

{%  schema  %} 
    {
        "name": "MS tools",
        "settings": [
            {
                "type": "header",
                "content": "content"
            },
            {
                "type": "text",
                "id": "tools_title",
                "label": "Tools title"
            },
            {
                "type": "text",
                "id": "text_tools_title",
                "label": "text title"
            },
            {
                "type": "richtext",
                "id": "text_tools_description",
                "label": "description title"
            },
            {
                "type": "header",
                "content": "page position"
            },
            {
                "type": "range",
                "id": "margin_top",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "Margin top",
                "default": 0
            },
            {
                "type": "range",
                "id": "margin_bottom",
                "min": 0,
                "max": 100,
                "step": 1,
                "unit": "px",
                "label": "Margin bottom",
                "default": 0
            }
        ],
        "blocks": [
            {
                "type": "_ms-tools-item"
            },
            {
                "type": "_ms-tools-list"
            }
        ],
        "presets": [
            {
                "name": "ms tools"
            }
        ]
    }
{% endschema %}